{
  "name": "duolume",
  "version": "0.1.0",
  "description": "A small framework for animated scenes: PixiJS and Three.js as one picture, built from effects that react to each other and to the page.",
  "license": "MIT",
  "author": "teroshed",
  "homepage": "https://duolume.danielsite.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teroshed/duolume.git"
  },
  "bugs": {
    "url": "https://github.com/teroshed/duolume/issues"
  },
  "keywords": [
    "animation",
    "effects",
    "pixijs",
    "three.js",
    "webgl",
    "particles",
    "canvas",
    "background"
  ],
  "type": "module",
  "types": "./lib/src/index.d.ts",
  "module": "./lib/src/index.js",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./types": {
      "types": "./lib/src/types.d.ts",
      "default": "./lib/src/types.js"
    },
    "./effects": {
      "types": "./lib/effects/index.d.ts",
      "default": "./lib/effects/index.js"
    },
    "./effects/*": {
      "types": "./lib/effects/*.d.ts",
      "default": "./lib/effects/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3031 --strictPort --open /lab/",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "build": "tsc --noEmit && vite build",
    "build:lib": "bun scripts/build-lib.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3032 --strictPort",
    "prepublishOnly": "bun run typecheck && bun test tests && bun run build:lib"
  },
  "peerDependencies": {
    "pixi.js": "^8.20.1",
    "three": "~0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "pixi.js": "8.20.1",
    "three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
